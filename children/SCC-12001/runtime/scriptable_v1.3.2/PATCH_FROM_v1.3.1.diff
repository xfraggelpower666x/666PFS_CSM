 // ============================================================
+// R11 DISCOVERY OWNER EVIDENCE (READ-ONLY)
+// Urheber-ID nur von offiziellen Track-Antworten übernehmen.
+// Pro Export maximal 120 zusätzliche Metadaten-GETs, damit Limits
+// respektiert werden. Cache enthält ausschließlich geprüfte API-IDs.
+// UNKNOWN ist kein eigener Track und bleibt von Publikation ausgeschlossen.
+// ============================================================
+const OWNER_DETAIL_LOOKUP_MAX = 120;
+const OWNER_CACHE_FILE = "soundcloud_track_owner_evidence_cache.json";
+
+function ownerIdentityFromApi(track, ownAccountId) {
+  const nested = track && track.user && track.user.id != null ? String(track.user.id) : null;
+  const flat = track && track.user_id != null ? String(track.user_id) : null;
+  if (nested && flat && nested !== flat) {
+    return { owner_user_id: null, ownership_status: "UNKNOWN_REVIEW_REQUIRED",
+      owner_evidence: "CONFLICTING_API_USER_IDS" };
+  }
+  const id = nested || flat;
+  if (!id) return { owner_user_id: null, ownership_status: "UNKNOWN_REVIEW_REQUIRED",
+    owner_evidence: "NO_API_TRACK_USER_ID" };
+  return { owner_user_id: id,
+    ownership_status: id === String(ownAccountId) ? "OWNED" : "EXTERNAL",
+    owner_evidence: "SOUNDCLOUD_TRACK_API_USER_ID" };
+}
+
+function ownerCacheLocation(fm) {
+  return fm.joinPath(fm.joinPath(fm.documentsDirectory(), "SoundCloud_Album_Track_Exports"), OWNER_CACHE_FILE);
+}
+
+function readOwnerCache(fm) {
+  const path = ownerCacheLocation(fm);
+  if (!fm.fileExists(path)) return {};
+  try {
+    const c = JSON.parse(fm.readString(path));
+    if (!c || typeof c !== "object" || Array.isArray(c)) return {};
+    return c;
+  } catch (e) { console.warn("R11 Owner-Cache unlesbar; UNKNOWN bleibt gesperrt: " + String(e)); return {}; }
+}
+
+async function enrichAlbumOwnership(token, accountId, albums, uniqueTracks, fm) {
+  const cache = readOwnerCache(fm);
+  let lookedUp = 0;
+  let errors = 0;
+  for (const [key, item] of uniqueTracks.entries()) {
+    const tid = item.id == null ? null : String(item.id);
+    let evidence = ownerIdentityFromApi(item, accountId);
+    if (evidence.owner_evidence === "NO_API_TRACK_USER_ID" && tid && cache[tid] &&
+        cache[tid].owner_user_id != null && cache[tid].source === "SOUNDCLOUD_TRACK_DETAIL_GET") {
+      evidence = ownerIdentityFromApi({ user_id: cache[tid].owner_user_id }, accountId);
+      evidence.owner_evidence = "SOUNDCLOUD_TRACK_DETAIL_GET_CACHED";
+    }
+    if (evidence.owner_evidence === "NO_API_TRACK_USER_ID" && tid && lookedUp < OWNER_DETAIL_LOOKUP_MAX) {
+      lookedUp++;
+      try {
+        const full = await apiRequest("GET", `${API_BASE}/tracks/${encodeURIComponent(tid)}`, token);
+        if (full && full.id != null && String(full.id) === tid) {
+          evidence = ownerIdentityFromApi(full, accountId);
+          if (evidence.owner_user_id && evidence.owner_evidence === "SOUNDCLOUD_TRACK_API_USER_ID") {
+            cache[tid] = { owner_user_id: evidence.owner_user_id, source: "SOUNDCLOUD_TRACK_DETAIL_GET" };
+          }
+        } else evidence = { owner_user_id:null, ownership_status:"UNKNOWN_REVIEW_REQUIRED",
+          owner_evidence:"API_TRACK_ID_MISMATCH" };
+      } catch (e) {
+        errors++;
+        evidence = { owner_user_id:null, ownership_status:"UNKNOWN_REVIEW_REQUIRED",
+          owner_evidence:"API_LOOKUP_FAILED" };
+      }
+      await sleep(REQUEST_DELAY_SECONDS);
+    }
+    Object.assign(item, evidence);
+    uniqueTracks.set(key, item);
+  }
+  // Cache nur für valide Autor-ID-Belege; niemals Tokens speichern.
+  fm.writeString(ownerCacheLocation(fm), JSON.stringify(cache, null, 2));
+  const byId = new Map();
+  for (const item of uniqueTracks.values()) if (item.id != null) byId.set(String(item.id), item);
+  for (const album of albums) for (const track of album.tracks) {
+    const original = track.id == null ? null : byId.get(String(track.id));
+    if (original) Object.assign(track, {
+      owner_user_id: original.owner_user_id,
+      ownership_status: original.ownership_status,
+      owner_evidence: original.owner_evidence
+    });
+    else Object.assign(track, { owner_user_id:null, ownership_status:"UNKNOWN_REVIEW_REQUIRED",
+      owner_evidence:"TRACK_ID_NOT_IN_UNIQUE_INDEX" });
+  }
+  return { looked_up:lookedUp, api_errors:errors, cache_size:Object.keys(cache).length };
+}
